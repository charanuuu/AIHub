# AI Hub Backend Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# OpenAI API Settings
# Add your OpenAI API key here (e.g. sk-proj-...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# Database Configuration
# Local SQLite default (zero-setup dev): sqlite+aiosqlite:///./aihub.db
# Production PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/aihub
DATABASE_URL=sqlite+aiosqlite:///./aihub.db

# Redis Cache Configuration
# Redis server connection string
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=True
CACHE_DEFAULT_TTL=600

# Third-Party External Tool API Keys (Optional overrides)
OPENWEATHER_API_KEY=
